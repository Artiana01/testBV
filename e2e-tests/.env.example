# =============================================================
# Fichier de configuration des variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles
# Ne jamais committer le fichier .env dans Git !
# =============================================================

# URL de base de l'application à tester
BASE_URL=https://votre-app.com

# Identifiants de connexion pour les tests
TEST_EMAIL=votre@email.com
TEST_PASSWORD=votremotdepasse

# ---------------------------------------------------------------
# Base de données PostgreSQL pour l'historisation des tests
# Format Railway : postgresql://user:pass@host:5432/dbname
# Format local   : postgresql://postgres:password@localhost:5432/e2e_history
# Si non défini, l'historisation est désactivée (dégradé silencieux)
# ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/e2e_history
